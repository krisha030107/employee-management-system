<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Employee Management System | Login</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body class="login-page">

    <div class="login-wrapper">

        <div class="login-info">

            <div class="logo">
                ✦ EmployeeHub
            </div>

            <h1>
                Manage your<br>
                <span>employees better.</span>
            </h1>

            <p>
                A simple and smart employee management
                system for modern organizations.
            </p>

            <div class="features">

                <div>
                    <strong>👥 120+</strong>
                    <small>Employees</small>
                </div>

                <div>
                    <strong>🏢 8</strong>
                    <small>Departments</small>
                </div>

                <div>
                    <strong>📊 95%</strong>
                    <small>Attendance</small>
                </div>

            </div>

        </div>


        <div class="login-card">

            <div class="mobile-logo">
                ✦ EmployeeHub
            </div>

            <h2>Welcome Back 👋</h2>

            <p class="login-text">
                Login to access your dashboard
            </p>

            <form id="loginForm">

                <div class="input-group">

                    <label>Email Address</label>

                    <input
                        type="email"
                        id="email"
                        placeholder="admin@employeehub.com"
                        required
                    >

                </div>


                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        id="password"
                        placeholder="Enter your password"
                        required
                    >

                </div>


                <div class="login-options">

                    <label>
                        <input type="checkbox">
                        Remember me
                    </label>

                    <a href="#">Forgot password?</a>

                </div>


                <button type="submit" class="login-btn">
                    Login to Dashboard →
                </button>

                <p id="loginMessage"></p>

            </form>


            <div class="demo-login">

                <strong>Demo Account</strong>

                <p>Email: admin@employeehub.com</p>
                <p>Password: 12345</p>

            </div>

        </div>

    </div>

    <script src="js/script.js"></script>

</body>

</html>
